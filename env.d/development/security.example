# Copy to security.local (gitignored). Loaded ONLY by compose.security.yaml services.
# Never put demo credentials in POSTHOG_KEY / POSTHOG_HOST.
SECURITY_DEMO_POSTHOG_ENABLED=false
SECURITY_DEMO_POSTHOG_KEY=
# Select the ingestion origin of YOUR project: EU below, or https://us.i.posthog.com.
SECURITY_DEMO_POSTHOG_HOST=https://eu.i.posthog.com
SECURITY_DEMO_POSTHOG_BATCH_SIZE=100
SECURITY_DEMO_POSTHOG_TIMEOUT_SECONDS=10
# Use a fresh workdir for this version; old state fingerprints intentionally differ.
SECURITY_MONITORING_WORKDIR=/data/security/processed-demo-v5
# Optional digest via Django's existing mail backend (Mailcatcher in development).
SECURITY_DIGEST_ENABLED=false
SECURITY_DIGEST_RECIPIENTS=
SECURITY_DIGEST_INTERVAL_SECONDS=300
# Optional rule overrides (the YAML remains the source of defaults).
# SECURITY_MASS_DOWNLOAD_MINUTE_THRESHOLD=60
# SECURITY_MASS_DOWNLOAD_MINUTE_WINDOW_SECONDS=60
# SECURITY_MASS_DOWNLOAD_TEN_MINUTES_THRESHOLD=100
# SECURITY_MASS_DOWNLOAD_HOUR_THRESHOLD=300
# SECURITY_MASS_DOWNLOAD_BYTES_HOUR_THRESHOLD=2000000000
# SECURITY_PROBING_FIVE_MINUTES_THRESHOLD=10
# SECURITY_PROBING_FIVE_MINUTES_MIN_DISTINCT_RESOURCES=5
# SECURITY_PROBING_HOUR_THRESHOLD=30
# SECURITY_PERMISSION_CHANGES_FIVE_MINUTES_THRESHOLD=10
# SECURITY_PERMISSION_CHANGES_FIVE_MINUTES_MIN_DISTINCT_RESOURCES=5
# SECURITY_PERMISSION_CHANGES_HOUR_THRESHOLD=25
