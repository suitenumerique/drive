{
  "name": "@gouvfr-lasuite/drive-sdk",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/drive-sdk.umd.cjs",
  "module": "./dist/drive-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/drive-sdk.js",
      "require": "./dist/drive-sdk.umd.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite build -w --mode development",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write ./src",
    "check": "prettier --check ./src"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.104.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "sass": "1.105.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vite-plugin-dts": "5.1.2"
  }
}
