<mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-preview>
        <!--
            We load django tags here, in this way there are put within the body in html output
            so the html-to-text command includes it within its output
        -->
        {% load i18n static extra_tags %}
        {{ title }}
    </mj-preview>
    <mj-raw>
        <!-- Our colors are not designed for dark mode, ask clients to keep them -->
        <meta name="color-scheme" content="light only" />
        <meta name="supported-color-schemes" content="light only" />
    </mj-raw>
    <mj-attributes>
        <mj-all
            font-family="{{ font_stack }}"
            font-size="16px"
            line-height="24px"
            color="#3B3F44"
        />
        <mj-section padding="0" />
        <mj-column padding="0" />
        <mj-text padding="0" />
        <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
        /* Web fonts are only loaded by some email clients, others use the fallbacks.
           Django tags are put in CSS comments, otherwise MJML reformats them. */
        /* {% if font_regular_url %} */
        @font-face {
            font-family: "{{ font_family }}";
            font-style: normal;
            font-weight: 400;
            src: url("{{ font_regular_url }}") format("woff2");
        }
        /* {% endif %} */
        /* {% if font_bold_url %} */
        @font-face {
            font-family: "{{ font_family }}";
            font-style: normal;
            font-weight: 700;
            src: url("{{ font_bold_url }}") format("woff2");
        }
        /* {% endif %} */

        /* Reset */
        h1, h2, h3, h4, h5, h6, p {
            margin: 0;
            padding: 0;
        }

        a {
            color: #2845C1;
        }

        .footer-links a {
            color: #3E5DE7;
        }
    </mj-style>
    <mj-raw>
        <!-- Outlook on Windows falls back to Times New Roman on unknown fonts -->
        <!--[if mso]>
        <style>
            body, table, td, p, a, span, strong {
                font-family: Arial, Helvetica, sans-serif !important;
            }
        </style>
        <![endif]-->
    </mj-raw>
</mj-head>
