<mjml>
  <mj-include path="./partial/header.mjml" />

  <mj-body background-color="#FFFFFF" width="600px">
    <mj-include path="./partial/top.mjml" />
    <mj-section padding="24px 15px 0 15px">
      <mj-column>
        <!-- Main Message -->
        <mj-text>
          {{ message|capfirst }}
          <a href="{{ link }}">{{ link_label }}</a>
        </mj-text>
        <mj-button
          href="{{ link }}"
          background-color="#3E5DE7"
          color="#FFFFFF"
          border-radius="4px"
          width="216px"
          inner-padding="12px 0"
          padding="24px 0 0 0"
          line-height="18px"
        >
          {{ button_label }}
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>
</mjml>
