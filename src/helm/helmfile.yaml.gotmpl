environments:
  dev:
    values:
      - version: 0.22.1
  feature:
    values:
      - version: 0.22.1
        feature: ci
        domain: example.com
        imageTag: demo
---
repositories:
- name: dev-backends
  url: https://suitenumerique.github.io/helm-dev-backend
---

releases:
  - name: dev-backend
    namespace: {{ .Namespace }}
    chart: dev-backends/dev-backend
    version: 0.0.11
    values:
      - env.d/{{ .Environment.Name }}/values.dev-backend.yaml.gotmpl

  - name: drive
    version: {{ .Values.version }}
    namespace: {{ .Namespace }}
    chart: ./drive
    values:
      - env.d/{{ .Environment.Name }}/values.drive.yaml.gotmpl
